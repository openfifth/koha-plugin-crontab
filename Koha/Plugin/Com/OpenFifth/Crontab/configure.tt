[% USE Koha %]
[% USE raw %]
[% USE Asset %]
[% PROCESS 'i18n.inc' %]
[% SET method = 'configure' %]
[% SET plugin_title = t("Crontab") %]
[% WRAPPER 'wrapper-staff-tool-plugin.inc' %]
[% Asset.css("lib/select2/css/select2.min.css") | $raw %]
[% Asset.css("css/select2.css") | $raw %]
<style nonce="[% Koha.CSPNonce | $raw %]">
/* Koha's staff-global.css sets `input[type=checkbox] { height: unset; }`, which is
   more specific than Bootstrap 5's `.form-check-input` rule and collapses these
   checkboxes to a sliver. Restore Bootstrap's sizing for ours specifically
   (margin is intentionally left alone: Bootstrap's `.form-check .form-check-input`
   already wins the cascade for margin-left, and overriding it here would break it). */
#crontab_plugin_configure .script-policy-scroll {
    max-height: 26rem;
    overflow-y: auto;
    border: 1px solid #dee2e6;
    border-radius: 0.375rem;
}
#crontab_plugin_configure .script-policy-scroll thead th {
    z-index: 1;
}
#crontab_plugin_configure .form-check-input[type="checkbox"] {
    width: 1em;
    height: 1em;
}
</style>

<div id="crontab_plugin_configure">
    <h1>Crontab: Configuration</h1>

    <form method="post" action="/cgi-bin/koha/plugins/run.pl">
        [% INCLUDE 'csrf-token.inc' %]
        <input type="hidden" name="class" value="[% CLASS | html %]" />
        <input type="hidden" name="method" value="[% METHOD | html %]" />
        <input type="hidden" name="op" value="cud-save" />

    <fieldset class="rows">
        <legend>Global Settings</legend>

        <ol>
            <li>
                <label for="enable_logging">Enable logging: </label>
                <select name="enable_logging">
                    [% IF enable_logging == 'No' %]
                        <option value="No" selected="selected">No</option>
                    [% ELSE %]
                        <option value="No">No</option>
                    [% END %]

                    [% IF enable_logging == 'Yes' %]
                        <option value="Yes" selected="selected">Yes</option>
                    [% ELSE %]
                        <option value="Yes">Yes</option>
                    [% END %]
                </select>
            </li>
            <li>
                <label for="backup_retention">Crontab backup retention: </label>
                <input type="number" name="backup_retention" id="backup_retention"
                       value="[% backup_retention || 10 %]" min="1" max="100" size="5" />
                <div class="hint">
                    Number of crontab backup files to keep.
                    Older backups will be automatically deleted. Default: 10
                </div>
            </li>
        </ol>
    </fieldset>

    <fieldset class="rows">
        <legend>Security Settings</legend>

        <ol>
            <li>
                <label for="patron_allowlist">User allowlist: </label>
                <select name="patron_allowlist" id="patron_allowlist" multiple="multiple"></select>
                <input type="hidden" name="user_allowlist" id="user_allowlist" value="[% user_allowlist | html %]" />
                <div class="hint">
                    Search and select patrons allowed to use this plugin. Leave empty to allow all staff users.
                    <br/><strong>Note:</strong> Superlibrarians always have access regardless of this setting.
                </div>
            </li>
            <li>
                <label for="script_picker">Script policy: </label>
                <select name="script_picker" id="script_picker" multiple="multiple"></select>
                <input type="hidden" name="script_policy" id="script_policy" value="[% script_policy | html %]" />
                <input type="hidden" id="server_policy" value="[% server_policy | html %]" />
                <div class="hint">
                    Search and select the scripts users may schedule. <strong>If nothing is selected, no scripts can be scheduled.</strong>
                    <br/><strong>Note:</strong> You can also type directory prefixes (e.g., <code>batch/</code>) to allow all scripts in that directory.
                    <br/><strong>Note:</strong> Exact scripts (not prefixes) can additionally be marked non-repeatable or restricted to specific hours below the picker.
                </div>
                <div id="script_policy_restricted_note" class="alert alert-info mt-2" style="display: none;">
                    Your server administrator limits which scripts can be offered here. Only the scripts and directories
                    their policy file permits can be selected; anything outside it would be ignored.
                </div>
                <div id="script_policy_open_note" class="alert alert-warning mt-2" style="display: none;">
                    <i class="fa fa-exclamation-triangle"></i> <strong>No server policy file is configured.</strong>
                    Anyone who can open this page can allow <em>any</em> script under the cron directory, so what is chosen here is
                    the only limit on what can be scheduled. To restrict it, your server administrator can set
                    <code>koha_plugin_crontab_script_policy</code> in <code>koha-conf.xml</code> to a policy file; this page can then
                    only narrow it.
                </div>
                <div id="script_policy_panels"></div>
            </li>
        </ol>
    </fieldset>

    <fieldset class="action">
        <input class="btn btn-primary" type="submit" value="Save" />
        <a class="cancel" href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS | uri %]&amp;method=[% METHOD | uri %]">Cancel</a>
    </fieldset>
    </form>
</div>

[%# The wrapper loads jQuery and Koha's scripts at the bottom of the page and
    replaces the page-level jsinclude, so this script waits for the DOM, loads
    the libraries it needs after jQuery, and then runs. #%]
[% SET select2_src = Asset.js("lib/select2/js/select2.min.js").match('src="([^"]+)"').0 %]
[% SET select2_init_src = Asset.js("js/select2.js").match('src="([^"]+)"').0 %]
<script nonce="[% Koha.CSPNonce | $raw %]">
    document.addEventListener("DOMContentLoaded", function () {
        function loadScript(src) {
            return new Promise(function (resolve, reject) {
                let script = document.createElement("script");
                script.src = src;
                script.onload = resolve;
                script.onerror = function () { reject(new Error("Failed to load " + src)); };
                document.head.appendChild(script);
            });
        }

        loadScript("[% select2_src | $raw %]").then(function () {
            return loadScript("[% select2_init_src | $raw %]");
        }).then(function () {
        $(document).ready(function() {
                // Initialize patron allowlist select2
                $("#patron_allowlist").kohaSelect({
                    width: "50%",
                    multiple: true,
                    allowClear: true,
                    minimumInputLength: 3,
                    ajax: {
                        url: "/api/v1/patrons",
                        delay: 250,
                        dataType: "json",
                        headers: {
                            "x-koha-embed": "library"
                        },
                        data: function(params) {
                            let q = buildPatronSearchQuery(params.term);
                            let query = {
                                q: JSON.stringify(q),
                                _page: params.page,
                                _order_by: "+me.surname,+me.firstname"
                            };
                            return query;
                        },
                        processResults: function(data, params) {
                            let results = [];
                            data.results.forEach(function(patron) {
                                patron.id = patron.patron_id;
                                results.push(patron);
                            });
                            return {
                                results: results,
                                pagination: { more: data.pagination.more }
                            };
                        }
                    },
                    templateResult: function(patron) {
                        if (!patron.patron_id) {
                            return patron.text;
                        }
        
                        let $patron = $("<div></div>")
                            .append(
                                "" +
                                (patron.surname ? escape_str(patron.surname) + ", " : "") +
                                (patron.firstname ? escape_str(patron.firstname) + " " : "") +
                                (patron.cardnumber ? " (" + escape_str(patron.cardnumber) + ")" : "") +
                                "<small>" +
                                (patron.library ? ' <span class="ac-library">' + escape_str(patron.library.name) + "</span>" : "") +
                                "</small>"
                            );
                        return $patron;
                    },
                    templateSelection: function(patron) {
                        if (!patron.surname) {
                            return patron.text;
                        }
                        return escape_str(patron.surname) + ", " + escape_str(patron.firstname);
                    },
                    placeholder: __("Search for patrons to allow access")
                });
        
                // Load existing patrons if any
                let existingIds = $("#user_allowlist").val();
                if (existingIds) {
                    let patronIds = existingIds.split(/\s*,\s*/);
                    patronIds.forEach(function(patronId) {
                        if (patronId) {
                            $.ajax({
                                url: "/api/v1/patrons/" + patronId,
                                dataType: "json"
                            }).done(function(patron) {
                                let option = new Option(
                                    patron.surname + ", " + patron.firstname,
                                    patron.patron_id,
                                    true,
                                    true
                                );
                                $("#patron_allowlist").append(option).trigger('change');
                            });
                        }
                    });
                }
        
                // Initialize script policy picker
                let allScripts = [];
                let libraryPolicyState = {};
                let serverPolicy = {};
        
                try {
                    let serverPolicyData = JSON.parse($("#server_policy").val() || '{"scripts":[]}');
                    (serverPolicyData.scripts || []).forEach(function(entry) {
                        serverPolicy[entry.path] = entry;
                    });
                } catch (e) {
                    console.error('Failed to parse server policy', e);
                }
        
                // With a server policy file the server is a ceiling: only what it permits
                // can be offered, and free typing of directory prefixes is not allowed.
                let restricted = Object.keys(serverPolicy).length > 0;
                $("#script_policy_open_note").toggle(!restricted);

                function coveredByServer(path) {
                    if (!restricted) return true;
                    let name = path.replace(/\/+$/, '').replace(/^.*\//, '');
                    return Object.keys(serverPolicy).some(function(entry) {
                        let dir = entry.replace(/\/+$/, '');
                        return entry === path || entry === name || (dir && path.indexOf(dir + '/') === 0);
                    });
                }

                function isExactScript(path) {
                    return allScripts.some(function(candidate) {
                        let relative = candidate.relative_path.replace(/^\$KOHA_CRON_PATH\/?/, '');
                        return relative === path || candidate.name === path;
                    });
                }
        
                function emptyLibraryState() {
                    return { non_repeatable: false, allowed_hours: '', required_options: [] };
                }
        
                // path -> what the Configure page needs to know about a script's options:
                //   describe: the script declares its options with Koha::Script->describe_options,
                //   declared: names of options the script itself requires,
                //   options:  options that take a value (what an administrator could additionally require)
                let scriptOptionsCache = {};

                function emptyOptionInfo() {
                    return { describe: false, declared: [], options: [] };
                }

                function fetchMissingScriptOptions(paths, callback) {
                    let toFetch = paths.filter(function(path) {
                        return !scriptOptionsCache.hasOwnProperty(path);
                    });

                    if (!toFetch.length) {
                        callback();
                        return;
                    }

                    let requests = toFetch.map(function(path) {
                        let match = allScripts.find(function(s) {
                            let relative = s.relative_path.replace(/^\$KOHA_CRON_PATH\/?/, '');
                            return relative === path || s.name === path;
                        });

                        if (!match || match.type !== 'perl') {
                            scriptOptionsCache[path] = emptyOptionInfo();
                            return $.Deferred().resolve().promise();
                        }

                        return $.ajax({
                            url: '/api/v1/contrib/crontab/scripts/details',
                            method: 'GET',
                            data: { name: match.name, bypass_filter: 1 }
                        }).done(function(data) {
                            let all = data.options || [];
                            scriptOptionsCache[path] = {
                                describe: !!data.uses_describe_options,
                                declared: all.filter(function(o) { return o.declared_required; }).map(function(o) { return o.name; }),
                                options: all.filter(function(o) {
                                    return o.type !== 'boolean' && o.type !== 'incremental';
                                })
                            };
                        }).fail(function() {
                            scriptOptionsCache[path] = emptyOptionInfo();
                        });
                    });

                    $.when.apply($, requests).always(callback);
                }

                function renderPolicyPanels() {
                    let selected = $("#script_picker").val() || [];
                    fetchMissingScriptOptions(selected.filter(isExactScript), function() {
                        renderPolicyPanelsNow(selected);
                    });
                }

                function optionBadge(classes, name, title) {
                    return '<span class="badge ' + classes + ' me-1" title="' + escape_str(title) + '">--' + escape_str(name) + '</span>';
                }

                // One compact table instead of a card per script: a row per selected script
                // with its constraints in columns, so many scripts stay scannable.
                function renderPolicyPanelsNow(selected) {
                    let container = $("#script_policy_panels");
                    container.empty();

                    if (!selected.length) {
                        return;
                    }

                    let tbody = $('<tbody></tbody>');

                    selected.forEach(function(path) {
                        if (!isExactScript(path)) {
                            // A directory: per-script constraints can't be set on it
                            tbody.append(
                                '<tr><td><code>' + escape_str(path) + '</code></td>' +
                                '<td colspan="3" class="text-muted">Every script in this directory. Select individual scripts to set constraints on them.</td></tr>'
                            );
                            return;
                        }

                        let serverEntry = serverPolicy[path] || {};
                        let state = libraryPolicyState[path] || emptyLibraryState();
                        let info = scriptOptionsCache[path] || emptyOptionInfo();

                        let locked = !!serverEntry.non_repeatable;
                        let nonRepeatable = locked || state.non_repeatable;
                        let hoursLocked = !!serverEntry.allowed_hours;
                        let allowedHours = hoursLocked ? serverEntry.allowed_hours : state.allowed_hours;
                        let serverRequired = (serverEntry.required_options || []).filter(function(n) { return info.declared.indexOf(n) === -1; });
                        let libraryRequired = state.required_options || [];

                        // Required options the script declares itself are shown, not editable: the
                        // script enforces them whatever the policy says.
                        let requiredHtml = '';
                        info.declared.forEach(function(name) {
                            requiredHtml += optionBadge('text-bg-secondary', name, 'Required by the script itself');
                        });
                        serverRequired.forEach(function(name) {
                            requiredHtml += optionBadge('text-bg-info', name, 'Set by the server administrator');
                        });

                        // Plain GetOptions scripts give no signal about what matters, so an
                        // administrator can choose. A script that declares its own options doesn't
                        // need that, unless an older policy already added some (so they can be removed).
                        let candidates = info.options.filter(function(o) {
                            return info.declared.indexOf(o.name) === -1 && serverRequired.indexOf(o.name) === -1;
                        });
                        let showPicker = candidates.length && ( !info.describe || libraryRequired.length );
                        if (showPicker) {
                            requiredHtml += '<select multiple class="form-select form-select-sm policy-required-select mt-1" data-path="' + escape_str(path) + '">';
                            candidates.forEach(function(o) {
                                requiredHtml += '<option value="' + escape_str(o.name) + '"' + (libraryRequired.indexOf(o.name) !== -1 ? ' selected' : '') + '>--' + escape_str(o.name) + '</option>';
                            });
                            requiredHtml += '</select>';
                        }
                        if (!requiredHtml) {
                            requiredHtml = '<span class="text-muted">' + (info.describe ? 'none declared' : '&mdash;') + '</span>';
                        }

                        tbody.append(
                            '<tr>' +
                                '<td><code>' + escape_str(path) + '</code></td>' +
                                '<td class="text-center">' +
                                    '<input class="form-check-input policy-non-repeatable" type="checkbox" data-path="' + escape_str(path) + '"' +
                                        (nonRepeatable ? ' checked' : '') + (locked ? ' disabled' : '') +
                                        ' aria-label="Non-repeatable: ' + escape_str(path) + '"' +
                                        (locked ? ' title="Set by the server administrator"' : '') + '>' +
                                '</td>' +
                                '<td>' +
                                    '<input type="text" class="form-control form-control-sm policy-allowed-hours" data-path="' + escape_str(path) + '" placeholder="e.g. 1-5" value="' + escape_str(allowedHours) + '"' +
                                        ' aria-label="Allowed hours: ' + escape_str(path) + '"' +
                                        (hoursLocked ? ' disabled title="Set by the server administrator"' : '') + '>' +
                                '</td>' +
                                '<td>' + requiredHtml + '</td>' +
                            '</tr>'
                        );
                    });

                    let table = $(
                        '<table class="table table-sm table-striped align-middle mb-0 w-100">' +
                            '<thead class="table-light sticky-top"><tr>' +
                                '<th>Script</th><th class="text-center">Non-repeatable</th><th style="width: 9rem">Allowed hours</th><th>Required options</th>' +
                            '</tr></thead>' +
                        '</table>'
                    );
                    table.append(tbody);

                    container.append($('<div class="script-policy-scroll"></div>').append(table));
                    container.append(
                        '<div class="form-text mt-1">' +
                            '<span class="badge text-bg-secondary">--option</span> is required by the script itself; ' +
                            '<span class="badge text-bg-info">--option</span> is set by your server administrator. ' +
                            'Greyed-out controls are set by the server and cannot be changed here.' +
                        '</div>'
                    );

                    container.find('.policy-required-select').select2({
                        width: '100%',
                        closeOnSelect: false,
                        placeholder: 'Also require\u2026'
                    });

                    container.find('.policy-non-repeatable').on('change', function() {
                        let path = $(this).data('path');
                        libraryPolicyState[path] = libraryPolicyState[path] || emptyLibraryState();
                        libraryPolicyState[path].non_repeatable = $(this).is(':checked');
                    });

                    container.find('.policy-allowed-hours').on('input', function() {
                        let path = $(this).data('path');
                        libraryPolicyState[path] = libraryPolicyState[path] || emptyLibraryState();
                        libraryPolicyState[path].allowed_hours = $(this).val();
                    });

                    container.find('.policy-required-select').on('change', function() {
                        let path = $(this).data('path');
                        libraryPolicyState[path] = libraryPolicyState[path] || emptyLibraryState();
                        libraryPolicyState[path].required_options = $(this).val() || [];
                    });
                }

                // Load all available scripts (with bypass_filter=1 to see all scripts for configuration)
                $.ajax({
                    url: '/api/v1/contrib/crontab/scripts?bypass_filter=1',
                    method: 'GET',
                    success: function(data) {
                        if (data.scripts) {
                            allScripts = data.scripts;
                            initializeScriptPicker();
                        }
                    },
                    error: function() {
                        console.error('Failed to load scripts');
                    }
                });
        
                function initializeScriptPicker() {
                    let candidates = allScripts.map(function(script) {
                        return {
                            id: script.relative_path.replace(/^\$KOHA_CRON_PATH\/?/, ''),
                            text: script.name,
                            description: script.description,
                            path: script.relative_path.replace(/^\$KOHA_CRON_PATH\/?/, ''),
                            type: script.type
                        };
                    });

                    if (restricted) {
                        $("#script_policy_restricted_note").show();

                        // The server's directory entries are choices too: selecting one allows
                        // everything under it (individual scripts above can narrow further).
                        Object.keys(serverPolicy).forEach(function(path) {
                            if (!isExactScript(path)) {
                                candidates.push({
                                    id: path,
                                    text: path,
                                    description: 'Every script under this directory',
                                    path: path,
                                    type: 'directory'
                                });
                            }
                        });
                    }

                    $("#script_picker").select2({
                        width: "75%",
                        multiple: true,
                        allowClear: true,
                        tags: !restricted, // Free entries like "batch/" only when no server policy limits the choices
                        data: candidates,
                        templateResult: function(script) {
                            if (!script.id) {
                                return script.text;
                            }
        
                            let $script = $("<div></div>");
                            let html = '<strong>' + escape_str(script.text) + '</strong>';
        
                            if (script.type) {
                                html += ' <span class="badge badge-secondary">' + script.type + '</span>';
                            }
        
                            if (script.description) {
                                html += '<br><small class="text-muted">' + escape_str(script.description) + '</small>';
                            }
        
                            if (script.path) {
                                html += '<br><small><code>' + escape_str(script.path) + '</code></small>';
                            }
        
                            $script.html(html);
                            return $script;
                        },
                        templateSelection: function(script) {
                            if (script.text) {
                                return escape_str(script.text);
                            }
                            return escape_str(script.id);
                        },
                        placeholder: restricted ? "Select from the scripts your server administrator permits" : "Select scripts or type directory prefixes (e.g., batch/)"
                    });
        
                    // Load existing library-tier selections and policy
                    let existingPolicy = { scripts: [] };
                    try {
                        existingPolicy = JSON.parse($("#script_policy").val() || '{"scripts":[]}');
                    } catch (e) {
                        console.error('Failed to parse existing script policy', e);
                    }
        
                    (existingPolicy.scripts || []).forEach(function(entry) {
                        libraryPolicyState[entry.path] = {
                            non_repeatable: !!entry.non_repeatable,
                            allowed_hours: entry.allowed_hours || '',
                            required_options: entry.required_options || []
                        };
        
                        let existingOption = allScripts.find(s =>
                            s.relative_path.replace(/^\$KOHA_CRON_PATH\/?/, '') === entry.path ||
                            s.name === entry.path
                        );
        
                        let displayText = existingOption ? existingOption.name : entry.path;
                        if (!coveredByServer(entry.path)) {
                            displayText += ' (not permitted by the server policy: ignored)';
                        }
                        let option = new Option(displayText, entry.path, true, true);
                        $("#script_picker").append(option);
                    });
                    $("#script_picker").trigger('change');
        
                    renderPolicyPanels();
        
                    $("#script_picker").on('change', function() {
                        let selected = $(this).val() || [];
                        Object.keys(libraryPolicyState).forEach(function(path) {
                            if (selected.indexOf(path) === -1) {
                                delete libraryPolicyState[path];
                            }
                        });
                        renderPolicyPanels();
                    });
                }
        
                // Update hidden fields on form submit
                $("form").on("submit", function() {
                    // Handle patron allowlist
                    let selectedIds = $("#patron_allowlist").val();
                    if (selectedIds && selectedIds.length > 0) {
                        $("#user_allowlist").val(selectedIds.join(","));
                    } else {
                        $("#user_allowlist").val("");
                    }
        
                    // Handle script policy
                    let selectedScripts = $("#script_picker").val() || [];
                    let scriptsPayload = selectedScripts.map(function(path) {
                        let state = libraryPolicyState[path] || emptyLibraryState();
                        let exact = isExactScript(path);
                        return {
                            path: path,
                            non_repeatable: exact ? !!state.non_repeatable : false,
                            allowed_hours: exact ? ( state.allowed_hours || '' ) : '',
                            required_options: exact ? ( state.required_options || [] ) : []
                        };
                    });
                    $("#script_policy").val(JSON.stringify({ scripts: scriptsPayload }));
                });
            });
        });
    });
</script>
[% END %]
